void DrawLeaderboardScreen(void)
{
    char entryString[32];
    uint8_t i;
    uint8_t toShow;
    uint16_t y;

    EnsureLeaderboardSeeded();


    LCD_BlankArea(0, 0, 240, 320, 0xAFB7);
    LCD_PutString(70, 10, (uint8_t*)"LEADERBOARD", 0x01AF, 0xAFB7);
    LCD_PutString( 10, 30, (uint8_t*)"Rank", 0x01AF, 0xAFB7);
    LCD_PutString(55, 30, (uint8_t*)"Score", 0x01AF, 0xAFB7);
    LCD_PutString(120, 30, (uint8_t*)"Level", 0x01AF, 0xAFB7);
    LCD_PutString(180, 30, (uint8_t*)"Time", 0x01AF, 0xAFB7);

    if (leaderboard_count < 10) {
        toShow = leaderboard_count;
    } else {
        toShow = 10;
    }

    for (i = 0; i < toShow; i++)
    {
        y = 50 + (uint16_t)i * 20;
        sprintf(entryString, "%u", (uint16_t)(i + 1));
        LCD_PutString( 10, y, (uint8_t*)entryString, 0x0000, 0xAFB7);
        sprintf(entryString, "%5u", leaderboard[i].score);
        LCD_PutString( 55, y, (uint8_t*)entryString, 0x0000, 0xAFB7);
        sprintf(entryString, "L%1u", leaderboard[i].level);
        LCD_PutString(120, y, (uint8_t*)entryString, 0x0000, 0xAFB7);
        sprintf(entryString, "%02u:%02u",
                leaderboard[i].minutes,
                leaderboard[i].seconds);
        LCD_PutString(180, y, (uint8_t*)entryString, 0x0000, 0xAFB7);
    }


    LCD_PutString( 60, 300, (uint8_t*)"SW2 TO RESTART", 0xF800, 0xAFB7);
}
